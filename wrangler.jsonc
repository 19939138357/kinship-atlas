{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinship-atlas",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
